# Bu dosya örnektir. Yeni bir Supabase projesine geçildiğinde `.env` dosyasındaki
# değerler bu iki satırla değiştirilir (Supabase → Project Settings → API Keys).
#
# Kural: yalnız istemciye açık anahtarlar. service_role / sb_secret ASLA.

VITE_SUPABASE_URL=https://PROJE-KIMLIGI.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXX
